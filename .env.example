DATABASE_URL=postgresql://postgres:postgres@localhost:5444/restaurant_ordering
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restaurant_ordering
DB_PORT=5444
DB_CONTAINER_NAME=restaurant-ordering-system-poc-db
API_PORT=3011
API_INTERNAL_URL=http://127.0.0.1:3011
APP_ORIGIN=http://localhost:3010
NODE_ENV=development
# Required for password reset and staff invitation emails. Verify the sender domain with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional private S3 bucket for customer PromptPay slips. Use an IAM role in production.
AWS_REGION=ap-southeast-1
PAYMENT_SLIP_S3_BUCKET=
# Optional platform operator. Restaurants create their own accounts at /signup.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Production Compose only:
# PUBLIC_HOST=order.example.com
# PRODUCTION_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@postgres:5432/restaurant_ordering
